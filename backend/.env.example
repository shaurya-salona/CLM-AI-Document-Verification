# Database Configuration (SQLite default / PostgreSQL option)
# SQLite:
DATABASE_URL=sqlite:///./clm_database.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://username:password@localhost:5432/clm_db

# OpenAI API Settings
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini
AI_PROVIDER=openai

# Upload Settings
UPLOAD_DIR=uploads
